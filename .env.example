# Vul deze waarden in op basis van `supabase start` (lokaal) of je Supabase-cloudproject.
# Dit bestand bevat GEEN echte waarden; kopieer het naar .env.local.
#
# Belangrijk: de service_role-sleutel komt hier bewust niet in voor. De client gebruikt
# alleen de anon key; alle gevoelige bewerkingen lopen via `security definer`-functies
# met Row Level Security in de database.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
