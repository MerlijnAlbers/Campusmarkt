# Vul deze waarden in op basis van `supabase start` (lokaal) of je Supabase-cloudproject.
# Dit bestand bevat GEEN echte waarden; kopieer het naar .env.local.
#
# De publishable key is voor de client; alle gevoelige bewerkingen lopen via
# `security definer`-functies met Row Level Security in de database.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (GEEN NEXT_PUBLIC_-prefix!) — alleen gebruikt door app/api/auth/reset/route.ts
# (lib/supabase/admin.ts) om een resetcode te verwerken. Nooit naar de browser, nooit elders
# gebruiken. Lokaal: de "service_role key" uit `supabase status`. Cloud/Vercel: de secret key
# (sb_secret_...) uit Project Settings → API Keys, als Vercel-variabele van het type Secret.
SUPABASE_SECRET_KEY=
